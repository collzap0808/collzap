# Copy to .env and adjust per environment.
# Both default to the local Spring Boot backend when unset.

# REST API base. Must include the /api prefix.
VITE_API_URL=http://localhost:8081/api

# SockJS/STOMP endpoint for chat.
VITE_WS_URL=http://localhost:8081/ws

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Used on the landing page only;
# leave unset to disable tracking.
VITE_GA_MEASUREMENT_ID=
