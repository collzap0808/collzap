# Copy to .env (gitignored) and fill in real values before running
# `docker compose up -d` on the server. Never commit the real .env.

# --- nginx / HTTPS ---
API_DOMAIN=api.collzap.com
CERTBOT_EMAIL=you@example.com

# --- Database (Supabase Postgres) ---
# Use Supabase's "Session" pooler connection (port 6543) or the direct
# connection (port 5432) — not the "Transaction" pooler, which doesn't play
# well with a long-lived Hikari connection pool. sslmode=require is mandatory.
DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# --- Redis ---
# "redis" is the docker-compose service name, not localhost — the backend
# reaches it over the internal compose network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
# Generate a real random value, e.g.: openssl rand -base64 48
JWT_SECRET=

# --- Bootstrap admin ---
# Leave ADMIN_BOOTSTRAP_PASSWORD blank to have the app generate and log a
# random one on first boot instead (check `docker compose logs backend` right
# after the first start, then change it from the admin panel).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Demo colleges/interests/dummy questions — must stay false against a real
# database. The app refuses to start with this true under SPRING_PROFILES_ACTIVE=prod.
SEED_DEMO_DATA=false

# Never log raw OTP codes in production.
LOG_OTP_CODES=false

# Real retake lock, not the 0-day dev override.
RETAKE_LOCK_DAYS=30

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM_ADDRESS=otp@mail.collzap.com

# --- File uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Analytics (admin Analytics page) ---
# Numeric GA4 property ID, and the service-account JSON key encoded as one
# base64 line (base64 -w0 key.json). Give that service account Viewer access
# on the property. Leave blank to hide the numbers.
GA_PROPERTY_ID=
GA_CREDENTIALS_BASE64=

# --- CORS ---
# Comma-separated. Must include wherever the frontend is actually deployed
# (e.g. its Vercel URL) or the browser will block every request with a CORS error.
COLLZAP_CORS_ALLOWED_ORIGINS=https://collzap.com,https://www.collzap.com
